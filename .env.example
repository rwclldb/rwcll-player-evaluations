# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public self-registration is disabled unless explicitly enabled for local testing.

# Server-only secret key (Project Settings -> API Keys -> secret key; locally: npx supabase status).
# Used by the People page to create and invite accounts. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=your-secret-key
